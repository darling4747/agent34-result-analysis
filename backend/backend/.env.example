# Agent 34 - Result Analysis Agent - Environment Configuration
# Copy this file to .env and fill in your values

# ── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL (production / demo)
DATABASE_URL=postgresql+psycopg2://postgres:CHANGE_ME@localhost:5432/result_analysis
# SQLite (local development only - not for production)
# DATABASE_URL=sqlite:///./result_analysis.db

# ── Application ───────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
UPLOAD_DIR=uploads
REPORT_DIR=reports

# ── Assessment configuration ──────────────────────────────────────────────────
INTERNAL_MAX=30
EXTERNAL_MAX=70
TOTAL_MAX=100
GRADE_MAP_JSON={"O":10,"A+":9,"A":8,"B+":7,"B":6,"C":5,"P":4,"F":0}

# ── Intervention weights (must sum to 1.0) ────────────────────────────────────
INTERVENTION_FAILURE_WEIGHT=0.40
INTERVENTION_HISTORICAL_WEIGHT=0.30
INTERVENTION_SECTION_WEIGHT=0.20
INTERVENTION_CORRELATION_WEIGHT=0.10

# ── JWT Authentication ────────────────────────────────────────────────────────
JWT_SECRET_KEY=Ewx6vZvDrHMYZVrRL8ipMOGcSnLwNHD59VeK1P_ySaXz4aZBY6Ymj3fcuaM9z9ls
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
TEMP_PASSWORD_EXPIRY_HOURS=24

# ── Gemini AI (optional - falls back to deterministic if not set) ─────────────
LLM_PROVIDER=gemini
LLM_API_KEY=YOUR_GEMINI_API_KEY
LLM_MODEL=gemini-2.5-flash
